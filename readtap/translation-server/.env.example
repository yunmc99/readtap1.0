DEBUG=false
NODE_ENV=production

# Health/endpoint 인증
CONTEXT_SERVER_TOKEN=changeme-long-random-token
REQUEST_SIGNING_SECRET=
# 운영 배포(REQUIRE_SIGNING=true) 시 비워두지 말고 동일 시크릿 사용
REQUIRE_SIGNING=false

# 번역 provider
TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=your_deepl_key
DEEPL_USE_PRO=0
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key
KRDICT_API_KEY=your_krdict_key

# 캐시/타임아웃
CACHE_TTL_SECONDS=43200
REQUEST_TIMEOUT_MS=14000
# 운영: 실제 앱/웹 도메인만 넣어야 함. 빈값이면 브라우저 요청이 CORS 차단될 수 있음
ALLOWED_ORIGINS=

# 보호 설정
MAX_REQUEST_BYTES=12000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
