// Secrets.xcconfig.example
// 이 파일을 Secrets.xcconfig 으로 복사한 뒤 실제 값을 채워 넣으세요.
// Secrets.xcconfig 은 .gitignore 되어 있어 커밋되지 않습니다.
//
// cp Secrets.xcconfig.example Secrets.xcconfig
// 그런 다음 아래 placeholder를 실제 값으로 교체하세요.

// ──────────────────────────────────────────
// 운영 (Release 빌드에서 사용)
// 장기적으로는 앱에 고정 공용 시크릿을 넣기보다, 별도 백엔드/인증 계층이
// 짧은 만료 토큰을 발급하는 구조를 권장합니다.
// ──────────────────────────────────────────
CONTEXT_SERVER_PROD_BASE_URL = https:$()/readtap-translation-worker.ymcyun99.workers.dev
CONTEXT_SERVER_PROD_TOKEN = YOUR_PRODUCTION_CONTEXT_SERVER_TOKEN
CONTEXT_SERVER_PROD_SIGNING_SECRET = YOUR_PRODUCTION_REQUEST_SIGNING_SECRET
CONTEXT_SERVER_PROD_CLIENT_ID =
CONTEXT_SERVER_PROD_CERTIFICATE_PIN =
WORDNIK_PROD_API_KEY =

// ──────────────────────────────────────────
// 스테이징 (Debug 빌드에서 사용)
// 스테이징도 운영과 동일하게 token + signing secret 조합을 유지하세요.
// ──────────────────────────────────────────
CONTEXT_SERVER_STAGING_BASE_URL = https:$()/readtap-translation-worker-staging.ymcyun99.workers.dev
CONTEXT_SERVER_STAGING_TOKEN = YOUR_STAGING_CONTEXT_SERVER_TOKEN
CONTEXT_SERVER_STAGING_SIGNING_SECRET = YOUR_STAGING_REQUEST_SIGNING_SECRET
CONTEXT_SERVER_STAGING_CLIENT_ID =
CONTEXT_SERVER_STAGING_CERTIFICATE_PIN =
WORDNIK_STAGING_API_KEY =
